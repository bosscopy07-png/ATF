NODE_ENV=development
PORT=10000

# app mode: 'server' (web+webhook+admin) or 'worker' (reconciler+monitor)
APP_MODE=server

MONGODB_URI=

TELEGRAM_BOT_TOKEN=

SUPER_ADMIN_TELEGRAM_ID=

ADMIN_SESSION_SECRET=

ENCRYPTION_KEY=

TON_NETWORK=mainnet
TON_RPC_URL=
TON_API_KEY=

STONFI_API_URL=
STONFI_API_KEY=

ATF_JETTON_ADDRESS=

ADMIN_FEE_WALLET_ADDRESS=
ADMIN_WALLET_MNEMONIC=

PLATFORM_SWAP_FEE_PERCENT=1
MIN_SWAP_TON=0.1
MAX_SLIPPAGE_PERCENT=1.0

BOT_BRANDING_IMAGE_URL=https://res.cloudinary.com/dbn8lffbs/image/upload/v1788006440/file_000000008aa881f498b66ad9c6cb613d_sc95vu.png

ATF_PRICE_API_URL=
TON_PRICE_API_URL=
USD_NGN_RATE_API_URL=

BOT_USERNAME=your_bot_username
SUPPORT_CHANNEL_URL=https://t.me/your_support_channel

# Render injects this automatically; only needed for server mode
RENDER_EXTERNAL_URL=

# ─────────────────────────────────────────────
# ⛳ Feature flags — all new features DISABLED by default
# ─────────────────────────────────────────────
FEATURE_PORTFOLIO_SCREEN=false
FEATURE_MULTITOKEN_SWAP=false
FEATURE_TRANSFER_RELAY=false
FEATURE_TREASURY_SWEEP=false

# ─── Fee policy ───
# PRODUCT OWNER MUST APPROVE: input | output (default input = current behavior)
FEE_PLATFORM_BASE=input
FEE_TON_TO_TOKEN_PERCENT=2
FEE_TOKEN_TO_TON_INPUT_PERCENT=2
FEE_TOKEN_TO_TON_OUTPUT_PERCENT=1
FEE_TOKEN_TO_TOKEN_PERCENT=2
FEE_RELAY_TRANSFER_PERCENT=2

# ─── Transfer relay ───
RELAY_ADDRESSES_PER_USER=10
RELAY_WALLET_VERSION=v5r1
RELAY_MIN_RESERVE_NANO=10000000
RELAY_FORWARD_FEE_NANO=15000000
RELAY_REUSE_COOLDOWN_DAYS=10
RELAY_QUOTE_TTL_MS=60000
RELAY_LOCK_TTL_MS=120000
RELAY_PREPARE_RATE_LIMIT=6
RELAY_PREPARE_RATE_WINDOW_MS=60000
TREASURY_ADDRESS=
